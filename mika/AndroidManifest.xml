<!-- Mika Theme components, merged into the application -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.techvrs.cyberhome.mika.settings.MikaPreviewActivity"
            android:exported="true"
            android:label="@string/mika_theme_name"
            android:taskAffinity="${applicationId}.mika"
            android:theme="@style/Mika.Theme.Screen">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
