<!-- Round soft-pink button; translucent so it works on light and dark cards. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#66F28AAE" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#2EF28AAE" />
        </shape>
    </item>
</selector>
