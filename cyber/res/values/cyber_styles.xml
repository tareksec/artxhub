<!-- CyberHome design tokens: text styles. Usable from layouts and RemoteViews widgets. -->
<resources>
    <!-- Huge block digits (clock) -->
    <style name="Cyber.TextAppearance.Clock" parent="">
        <item name="android:fontFamily">@font/cyber_font_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">900</item>
        <item name="android:textSize">@dimen/cyber_text_clock</item>
        <item name="android:textColor">@color/cyber_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Medium display numbers (day counter, card numbers) -->
    <style name="Cyber.TextAppearance.Number" parent="">
        <item name="android:fontFamily">@font/cyber_font_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">@dimen/cyber_text_number</item>
        <item name="android:textColor">@color/cyber_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Cyber.TextAppearance.Title" parent="">
        <item name="android:fontFamily">@font/cyber_font_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">@dimen/cyber_text_title</item>
        <item name="android:textColor">@color/cyber_text</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="Cyber.TextAppearance.Body" parent="">
        <item name="android:fontFamily">@font/cyber_share_tech_mono</item>
        <item name="android:textSize">@dimen/cyber_text_body</item>
        <item name="android:textColor">@color/cyber_text</item>
    </style>

    <!-- Small uppercase captions with letter-spacing -->
    <style name="Cyber.TextAppearance.Label" parent="">
        <item name="android:fontFamily">@font/cyber_share_tech_mono</item>
        <item name="android:textSize">@dimen/cyber_text_label</item>
        <item name="android:textColor">@color/cyber_text_dim</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.15</item>
    </style>
</resources>
