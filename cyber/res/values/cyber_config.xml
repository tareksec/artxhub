<!-- Overrides of upstream config values (lawnchair/res/values/config.xml).
     Drawer and folder colors stay upstream defaults, so they follow the launcher's light/dark theme. -->
<resources>
    <!-- Default accent: CyberHome pink (cyber_soft_pink, readable in light and dark). Format parsed by ColorOption. -->
    <string name="config_default_accent_color" translatable="false">custom|#fff28aae</string>
    <!-- "At a Glance" would take the top row of page 1 that our layout uses; off by default. -->
    <bool name="config_default_enable_smartspace">false</bool>
    <!-- Soft rounded icons that match the board's 18dp cards. -->
    <string name="config_default_icon_shape" translatable="false">squircle</string>
</resources>
