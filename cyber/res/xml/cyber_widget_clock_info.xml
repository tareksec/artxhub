<!-- W1/W2 Block Clock: default 2x2 cells, resizable both ways. updatePeriodMillis=0 because
     TextClock updates itself (no wakeups, no battery cost). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/cyber_widget_clock_description"
    android:initialLayout="@layout/cyber_widget_clock"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:previewImage="@drawable/cyber_widget_clock_preview"
    android:previewLayout="@layout/cyber_widget_clock"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
