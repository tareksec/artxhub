<!-- W6 Weather tile (1x1): condition icon over temperature. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cyber_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cyber_widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/cyber_weather_icon"
            android:layout_width="@dimen/cyber_widget_icon"
            android:layout_height="@dimen/cyber_widget_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/cyber_ic_cloud" />

        <TextView
            android:id="@+id/cyber_weather_temp"
            style="@style/Cyber.TextAppearance.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cyber_weather_city"
            style="@style/Cyber.TextAppearance.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
